[Unit]
Description=crawm compositor
PartOf=graphical-session.target
After=graphical-session-pre.target
Before=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/crawm
Restart=on-failure
RestartSec=2
# The compositor needs to talk to the session manager and take over DRM.
Environment=XDG_CURRENT_DESKTOP=crawm
Environment=XDG_SESSION_TYPE=wayland

[Install]
WantedBy=graphical-session.target
